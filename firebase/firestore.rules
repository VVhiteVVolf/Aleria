rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return signedIn()
        && request.auth.token.keys().hasAll(['aleriaRole'])
        && request.auth.token.aleriaRole is string
        && request.auth.token.aleriaRole in roles;
    }

    function isModerator() {
      return hasRole(['admin', 'moderator']);
    }

    function isMechanicalComment(data) {
      return (data.keys().hasAny(['mechanicalAudit']) && data.mechanicalAudit == true)
        || (data.keys().hasAny(['combatTransaction']) && data.combatTransaction != null)
        || (data.keys().hasAny(['restTransaction']) && data.restTransaction != null)
        || (data.keys().hasAny(['combatStatus']) && data.combatStatus != null)
        || (data.keys().hasAny(['inventoryTransaction']) && data.inventoryTransaction != null)
        || (data.keys().hasAny(['sceneInventoryTransfer']) && data.sceneInventoryTransfer != null)
        || (data.keys().hasAny(['sceneRest']) && data.sceneRest != null)
        || (data.keys().hasAny(['sceneDiceRoll']) && data.sceneDiceRoll != null)
        || (data.keys().hasAny(['sceneTimeEvent']) && data.sceneTimeEvent != null)
        || (data.keys().hasAny(['skillResolution']) && data.skillResolution != null)
        || (data.keys().hasAny(['importedHistoricalMechanics']) && data.importedHistoricalMechanics == true)
        || (data.keys().hasAny(['serverValidatedMechanics']) && data.serverValidatedMechanics == true);
    }

    function combatProfileLocked(kind, recordId) {
      let lockPath = /databases/$(database)/documents/combat_profile_locks/$(kind)/records/$(recordId);
      return exists(lockPath)
        && get(lockPath).data.activeEncounterKeys is list
        && get(lockPath).data.activeEncounterKeys.size() > 0;
    }

    function changesCombatRelevantProfile() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['combatProfile', 'inventory']);
    }

    function pureTimeMarker(data) {
      return data.get('sceneTimeEvent', null) is map
        && data.get('sceneRest', null) == null
        && data.get('restTransaction', null) == null
        && data.get('combatTransaction', null) == null
        && data.get('combatResolution', null) == null
        && data.get('combatEncounter', null) == null
        && data.get('combatStatus', null) == null
        && data.get('inventoryTransaction', null) == null
        && data.get('sceneInventoryTransfer', null) == null
        && data.get('sceneDiceRoll', null) == null
        && data.get('skillResolution', null) == null
        && data.get('commentSegments', []) in [null, []];
    }

    function validCalendarDate(date) {
      return date is map && date.keys().hasOnly(['year', 'month', 'day'])
        && date.year is int && date.year >= 1 && date.year <= 100000
        && date.month is int && date.month >= 1 && date.month <= 13
        && date.day is int && date.day >= 1 && date.day <= 36;
    }

    function validTimeMarkerEdit() {
      let event = request.resource.data.sceneTimeEvent;
      return pureTimeMarker(resource.data) && pureTimeMarker(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'sceneTimeEvent', 'text', 'updatedAtClient', 'activityAtClient', 'updatedAt', 'activityAt'
        ])
        && event.anchorDay is int && event.anchorDay >= 1 && event.anchorDay <= 1000000
        && event.anchorSeconds is int && event.anchorSeconds >= 0 && event.anchorSeconds < 86400
        && event.calendarDay is int && event.calendarDay >= 1 && event.calendarDay <= 1000000
        && validCalendarDate(event.calendarDate)
        && event.title is string && event.title.size() <= 500
        && request.resource.data.text is string && request.resource.data.text.size() <= 10000;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if false;
      allow update: if !isMechanicalComment(resource.data)
        && !isMechanicalComment(request.resource.data)
        && signedIn()
        && request.resource.data.createdBy == resource.data.createdBy;
      allow update: if signedIn() && validTimeMarkerEdit();
      // Pure time markers do not reverse a character, inventory or combat transaction.
      allow delete: if signedIn()
        && (!isMechanicalComment(resource.data) || pureTimeMarker(resource.data));
    }

    match /characters/{recordId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && (!changesCombatRelevantProfile() || !combatProfileLocked('characters', recordId));
      allow delete: if signedIn() && !combatProfileLocked('characters', recordId);
    }

    match /creatures/{recordId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && (!changesCombatRelevantProfile() || !combatProfileLocked('creatures', recordId));
      allow delete: if signedIn() && !combatProfileLocked('creatures', recordId);
    }

    match /combat_profile_locks/{kind}/records/{recordId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /comment_turns/{threadId} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if signedIn();
    }

    match /char_tabs/{documentId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /module_store_entries/{documentId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /item_database/{documentId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /item_database_entries/{documentId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /character_archive_entries/{documentId} {
      allow read: if true;
      allow write: if signedIn()
        && documentId.size() > 0
        && documentId.size() <= 180;
    }

    match /topic_proposals/{proposalId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.status == 'open'
        && request.resource.data.votes is map
        && request.resource.data.votes.size() <= 100;
      allow update: if signedIn()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.status in ['open', 'archived']
        && request.resource.data.votes is map
        && request.resource.data.votes.size() <= 100;
      allow delete: if false;
    }

    match /calendar_events/{eventId} {
      function validEvent() {
        let event = request.resource.data;
        return event.keys().hasOnly([
          'id', 'schemaVersion', 'title', 'type', 'start', 'end', 'startTime', 'endTime',
          'location', 'summary', 'icon', 'articleHref', 'recurrence', 'participants',
          'revision', 'deleted', 'updatedBy', 'updatedAt'
        ]) && event.id == eventId && eventId.size() <= 100
          && event.schemaVersion == 1 && event.updatedBy == request.auth.uid
          && event.title is string && event.title.size() > 0 && event.title.size() <= 150
          && validCalendarDate(event.start) && validCalendarDate(event.end)
          && event.recurrence in ['none', 'week', 'year']
          && event.startTime is string && event.startTime.size() <= 5
          && event.endTime is string && event.endTime.size() <= 5
          && event.summary is string && event.summary.size() <= 2400
          && event.location is string && event.location.size() <= 200
          && event.icon is string && event.icon.size() <= 2000
          && event.articleHref is string && event.articleHref.size() <= 2000
          && event.participants is list && event.participants.size() <= 40
          && event.deleted is bool && event.revision is int;
      }
      allow read: if true;
      allow create: if signedIn() && validEvent() && request.resource.data.revision == 1;
      allow update: if signedIn() && validEvent() && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    match /almanach_settings/{settingId} {
      allow read: if true;
      allow create, update: if signedIn()
        && settingId == 'current-date'
        && request.resource.data.keys().hasOnly([
          'year', 'month', 'day', 'schemaVersion', 'updatedAtClient', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.year is int
        && request.resource.data.year > 0
        && request.resource.data.month is int
        && request.resource.data.month >= 1
        && request.resource.data.month <= 13
        && request.resource.data.day is int
        && request.resource.data.day >= 1
        && request.resource.data.day <= 36
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAtClient is number
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /aleria_roles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isModerator());
      allow write: if false;
    }

    match /mechanic_requests/{requestId} {
      allow read: if signedIn() && (resource.data.createdBy == request.auth.uid || isModerator());
      allow write: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if isModerator();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
