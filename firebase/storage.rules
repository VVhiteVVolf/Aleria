rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /family-assets/{familyId}/{assetId}/{fileName} {
      allow read: if resource.metadata.visibility == 'public';
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
