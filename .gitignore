# Local diagnostic browser profiles; keep collected project sources visible.
/diagnostics/**/chrome*-profile/

# Skyrim extraction and build workspaces. These rules only hide working copies
# from Git; local files, rollback backups, reports and custom scripts are kept.
# Do not ignore diagnostics/ wholesale: the outfit catalog imports a module
# from diagnostics/obody-bodyslide-audit-20261006/.
/diagnostics/new-followers-*/unpacked/
/diagnostics/new-followers-*/staged/
/diagnostics/new-followers-*/BuildCatalog/
/diagnostics/new-followers-*/generated/
/diagnostics/new-followers-*/BodySlide/
