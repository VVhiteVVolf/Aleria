    "persons": [
      {
        "id": "matteo-veltrane",
        "worldPersonId": "person--haus-veltrane--matteo-veltrane",
        "name": "Matteo Septimus Veltrane",
        "title": "Handelskapitän · Begründer der Gwynthorer Linie",
        "sex": "male",
        "status": "dead",
        "birth": "1633",
        "death": "1708",
        "portrait": "../AleriaAlmanach/assets/goettliche-eleganz/portraits/matteo.png",
        "portraitPlaceholder": "auto",
        "houseId": "house-veltrane",
        "familyRole": "core",
        "lineageRole": "branch",
        "tags": [],
        "notes": "Matteo kam mit Seide und Olivenöl nach Gwynthor und fand in Gwenoras Werkstatt einen Grund zu bleiben. Aus seinem kleinen Krämerladen und ihren Aufträgen wuchs ein Geschäft, das die Schiffe seines Stammhauses nie aus den Augen verlor.",
        "extensions": {
          "registryManagedFields": [
            "title",
            "notes",
            "portrait"
          ]
        }
      },
      {
        "id": "gwenora-maerllys",
        "worldPersonId": "person--haus-maerllys--gwenora-maerllys",
        "name": "Gwenora Maerllys",
        "title": "Schneidermeisterin · Mitbegründerin des Geschäfts",
        "sex": "female",
        "status": "dead",
        "birth": "1638",
        "death": "1714",
        "portrait": "../AleriaAlmanach/assets/goettliche-eleganz/portraits/gwenora-v2.png",
        "portraitPlaceholder": "auto",
        "houseId": "house-maerllys",
        "familyRole": "married",
        "lineageRole": "branch",
        "tags": [],
        "notes": "Gwenora verstand mehr von Stoff als die meisten Tuchhändler. Sie nähte für Gwynthors Bürger, handelte selbstbewusst mit dem fremden Kapitän und brachte ihm bei, dass ein gutes Geschäft am Saum ebenso leicht scheitert wie auf See.",
        "extensions": {
          "registryManagedFields": [
            "title",
            "notes",
            "portrait"
          ]
        }
      },
      {
        "id": "lorenzo-raves",
        "worldPersonId": "person--haus-raves--lorenzo-raves",
        "name": "Lorenzo Cassian Raves",
        "title": "Verstorbener Geschäftsinhaber",
        "sex": "male",
        "status": "dead",
        "birth": "1665",
        "death": "1734",
        "portrait": "../AleriaAlmanach/assets/goettliche-eleganz/portraits/lorenzo.png",
        "portraitPlaceholder": "auto",
        "houseId": "house-raves",
        "familyRole": "core",
        "lineageRole": "branch",
        "tags": [],
        "notes": "Lorenzo machte aus dem Krämerladen ein Haus für gute Kleidung. Er gab den Maßstuben feste Werkstätten und ließ lieber eine Lieferung ausfallen, als zweifelhafte Seide unter dem Namen Raves zu verkaufen.",
        "extensions": {
          "registryManagedFields": [
            "title",
            "notes",
            "portrait"
          ]
        }
      },
      {
        "id": "rhiain-raves",
        "worldPersonId": "person--haus-raves--rhiain-raves",
        "name": "Rhiain",
        "title": "Altmeisterin · Schnittkunde & Ausbildung",
        "sex": "female",
        "status": "alive",
        "birth": "1674",
        "death": "",
        "portrait": "../AleriaAlmanach/assets/goettliche-eleganz/portraits/rhiain.png",
        "portraitPlaceholder": "auto",
        "houseId": "",
        "familyRole": "married",
        "lineageRole": "branch",
        "tags": [],
        "notes": "Rhiain erkennt einen verzogenen Fadenlauf mit einem Blick. Die Witwe des alten Inhabers gibt ihre Schnitte und ihre Geduld an die Lehrlinge weiter; den letzten Stich einer Festgarnitur prüft sie gern noch selbst.",
        "extensions": {
          "registryManagedFields": [
            "title",
            "notes",
            "portrait"
          ]
        }
      },
      {
        "id": "livia-raves",
        "worldPersonId": "person--haus-raves--livia-raves",
        "name": "Livia Aurelia Raves",
        "title": "Nach Venalys verheiratet",
        "sex": "female",
        "status": "alive",
        "birth": "1669",
        "death": "",
        "portrait": "../AleriaAlmanach/assets/goettliche-eleganz/portraits/livia.png",
        "portraitPlaceholder": "auto",
        "houseId": "house-raves",
        "familyRole": "core",
        "lineageRole": "branch",
        "tags": [],
        "notes": "Livia lebt seit ihrer Heirat in Venalys. Ihre Briefe sind voll bissiger Bemerkungen über neue Säume, schlechte Festkleider und Menschen, die beides tragen. Gelegentlich reist ein seltenes Muster mit der Post nach Gwynthor.",
        "extensions": {
          "registryManagedFields": [
            "title",
            "notes",
            "portrait"
          ]
        }
      },
      {
        "id": "flavia-raves",
