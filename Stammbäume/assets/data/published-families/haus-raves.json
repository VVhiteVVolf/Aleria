        "houseId": "house-raves",
        "familyRole": "core",
        "lineageRole": "branch",
        "tags": [],
        "notes": "Eleonora führt die Göttliche Eleganz mit ruhiger Stimme und einem unerbittlichen Auge für den Sitz eines Gewandes. Sie berät selbst, zeichnet die besonderen Entwürfe und lässt keine Festgarnitur gehen, deren Träger sich darin verkleidet fühlt.",
        "extensions": {
          "registryManagedFields": [
            "title",
            "notes",
            "portrait"
          ]
        }
      },
      {
        "id": "tiberian-raves",
