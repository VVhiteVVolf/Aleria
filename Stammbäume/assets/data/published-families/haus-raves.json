        "portraitPlaceholder": "auto",
        "houseId": "house-raves",
        "familyRole": "core",
        "lineageRole": "branch",
        "tags": [],
        "notes": "Flavia kehrte durch ihre Heirat in den Süden zurück. Sie hat ein gutes Gedächtnis für Stoffpreise und ein besseres für Gefälligkeiten. In Gwynthor weiß man, dass ihre seltenen Empfehlungen eine Prüfung wert sind.",
        "extensions": {
          "registryManagedFields": [
            "title",
            "notes",
            "portrait"
          ]
        }
      },
      {
        "id": "eleonora-raves",
        "worldPersonId": "person--haus-raves--eleonora-raves",
        "name": "Eleonora Cassia Raves",
        "title": "Inhaberin · Entwurf & letzte Anprobe",
        "sex": "female",
        "status": "alive",
        "birth": "1701",
        "death": "",
