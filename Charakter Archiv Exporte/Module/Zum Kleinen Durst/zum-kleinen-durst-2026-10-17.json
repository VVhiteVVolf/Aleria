          }
        },
        {
          "schemaVersion": 1,
          "commentThreadKey": "durst-hinterhof",
          "pageTitle": "Vorratsverschlag und Hinterhof",
          "image": "./assets/kleiner-durst/scenes/hinterhof.png",
          "imageWidth": 34,
          "imageTall": true,
          "imageFit": "cover",
          "imagePosition": "center",
          "sessionPage": true,
          "sessionIntro": "<p>Hinter der Küche liegt ein schmaler Verschlag mit zwei Fässern, einem Sack Gerste und wenigen Kisten. Die Tür führt in einen winzigen Wirtschaftshof. Hier werden Holz gestapelt, Wasser getragen und leere Fischkisten ausgespült; Dewi kennt jede lose Diele auf dem Weg.</p>",
          "sessionHint": "Eine Begegnung im Kleinen Durst.",
